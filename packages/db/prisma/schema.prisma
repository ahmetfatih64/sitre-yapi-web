// Sitre Yapı — canonical data model.
// Lives in @sitre/db so future apps (web + admin + CRM workers) share one schema.
// Run: npm run -w @sitre/db generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth ───────────────────────────

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  SALES
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(VIEWER)
  totpSecret    String? // encrypted at rest (app layer)
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  passkeys      Passkey[]
  auditLogs     AuditLog[]
  leadsAssigned Lead[]    @relation("LeadAssignee")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash       String?
  uaHash       String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// WebAuthn / Passkey registration record.
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    Bytes    @unique
  publicKey       Bytes
  counter         BigInt
  deviceType      String
  backedUp        Boolean
  transports      String[]
  nickname        String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Audit ───────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ─────────────────────────── Content (Project) ───────────────────────────

enum ProjectStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

enum PublishState {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Authoring root. Editors mutate this. Public site reads PublishedProjectProjection.
model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  status          ProjectStatus @default(UPCOMING)
  publishState    PublishState  @default(DRAFT)
  shortSummary    String
  description     String        @db.Text
  locationLabel   String
  addressStreet   String?
  addressCity     String?
  lat             Float?
  lng             Float?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  coverImageUrl   String?
  tags            String[]

  // Authoring metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  revisions  ProjectRevision[]
  projection PublishedProjectProjection?
  media      MediaAttachment[]
  plans      Plan[]
  amenities  Amenity[]
  leads      Lead[]

  @@index([publishState])
  @@index([status])
}

/// Immutable history. One row per save. Latest published becomes projection.
model ProjectRevision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  payload   Json
  message   String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Read-optimized snapshot consumed by the public site (ISR-friendly).
model PublishedProjectProjection {
  projectId   String   @id
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug        String   @unique
  payload     Json
  publishedAt DateTime @default(now())
  revisionId  String
}

model Plan {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  category    String
  totalArea   Float
  netArea     Float
  orientation String?
  floorRange  String?
  imageUrl    String?

  @@unique([projectId, code])
}

model Amenity {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
}

// ─────────────────────────── Media ───────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
  PDF
  OTHER
}

model MediaAttachment {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  storageKey   String    @unique
  url          String
  kind         MediaKind
  mimeType     String
  width        Int?
  height       Int?
  byteSize     Int
  alt          String?
  caption      String?
  uploadedById String?
  createdAt    DateTime  @default(now())

  @@index([projectId])
}

// ─────────────────────────── Leads / CRM ───────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  WON
}

enum LeadSource {
  WEB_FORM
  PHONE
  WHATSAPP
  REFERRAL
  CAMPAIGN
  OTHER
}

model Lead {
  id                   String     @id @default(cuid())
  receivedAt           DateTime   @default(now())
  status               LeadStatus @default(NEW)
  source               LeadSource @default(WEB_FORM)
  name                 String
  email                String?
  phone                String?
  message              String?    @db.Text
  subject              String?
  projectInterest      String?
  ctaContext           String?
  utm                  Json?
  dedupeHash           String     @unique
  idempotencyKey       String?
  consentPolicyVersion String
  ipHash               String?
  userAgentHash        String?

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?    @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  notes LeadNote[]

  @@index([status, receivedAt])
  @@index([assigneeId])
  @@index([projectId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
}

// ─────────────────────────── Outbox ───────────────────────────

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Transactional outbox — written same-tx as the domain change, drained by worker.
model OutboxEvent {
  id           String       @id @default(cuid())
  topic        String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?
  scheduledFor DateTime     @default(now())
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, scheduledFor])
  @@index([topic])
}
