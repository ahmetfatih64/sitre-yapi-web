# =============================================================================
# Sitre Yapı — ortam değişkenleri
#
# Bu dosyayı `.env.local` olarak kopyalayıp doldurun. `.env.local` git'e
# girmez (.gitignore'da).
#
# Tasarım ilkesi: eksik değişken uygulamayı çökertmez, ilgili özelliği
# mock/log moduna düşürür. Hangi özelliğin açık olduğunu /api/health
# uç noktasından doğrulayabilirsiniz.
# =============================================================================


# -----------------------------------------------------------------------------
# ZORUNLU — ortam ve site kimliği
# -----------------------------------------------------------------------------

# Uygulamanın hangi ortamda çalıştığı: development | preview | staging | production
#
# !! DİKKAT: Canlı yayında "production" OLMAK ZORUNDA.
# Bu değer "production" değilse:
#   - robots.txt -> "Disallow: /" üretir, site arama motorlarına KAPANIR
#   - sitemap.xml yalnızca ana sayfayı listeler
# Ayarlanmazsa varsayılan "development"tır.
NEXT_PUBLIC_APP_ENV=development

# Sitenin genel adresi. Kanonik URL'ler, sitemap, robots ve OG etiketleri
# bunu kullanır. Sonunda eğik çizgi olmamalı.
NEXT_PUBLIC_SITE_URL=https://sitreyapi.com.tr


# -----------------------------------------------------------------------------
# VERİTABANI (Prisma / PostgreSQL)
#
# Yoksa: yönetim paneli ve talep (lead) kaydı devre dışı kalır.
# İletişim formu doğrulamadan geçer ama hiçbir yere yazılmaz.
# -----------------------------------------------------------------------------
DATABASE_URL=


# -----------------------------------------------------------------------------
# KİMLİK DOĞRULAMA (Auth.js v5)
#
# Yoksa: /admin üretimde giriş yaptırmaz. Geliştirmede sentetik bir OWNER
# oturumu kullanılır (src/lib/auth/session.ts).
# NEXTAUTH_SECRET üretmek için: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://sitreyapi.com.tr


# -----------------------------------------------------------------------------
# E-POSTA (Postmark)
#
# İki iş görür:
#   1. Yönetim paneline e-posta ile giriş bağlantısı (magic link)
#   2. Yeni talep geldiğinde bildirim gönderimi
# Yoksa: e-posta gönderimi log adaptörüne düşer, mesaj kimseye ulaşmaz.
# -----------------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=bilgi@sitreyapi.com.tr

# Yeni talep bildirimlerinin gideceği adresler. Virgülle ayrılır.
# Boşsa bildirim gönderilmez (talep yine veritabanına kaydedilir).
LEAD_NOTIFY_TO=


# -----------------------------------------------------------------------------
# BOT KORUMASI (Cloudflare Turnstile)
#
# Yoksa: form doğrulaması yapılır ama bot kontrolü atlanır.
# Rate limit her durumda çalışır.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# HIZ SINIRI / TEKİLLEŞTİRME (Upstash Redis)
#
# Yoksa: bellek içi sayaca düşer. Tek sunucuda çalışır, ancak birden fazla
# sunucu örneği varsa sınır her örnek için ayrı sayılır.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# MEDYA DEPOLAMA (Cloudflare R2)
#
# Yönetim panelinden görsel yüklemek için gerekli.
# Yoksa: yerel dosya sistemi adaptörü kullanılır (üretim için uygun değil).
# Beşi birden dolu olmalı, aksi halde R2 devre dışı sayılır.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=


# -----------------------------------------------------------------------------
# ZAMANLANMIŞ GÖREV (outbox kuyruğunu işler)
#
# /api/cron/outbox uç noktası "Authorization: Bearer <CRON_SECRET>" bekler.
# Üretimde BOŞ BIRAKILMAMALI: boşsa uç nokta üretimde tüm istekleri reddeder,
# yani bekleyen bildirimler hiç gönderilmez.
# -----------------------------------------------------------------------------
CRON_SECRET=


# -----------------------------------------------------------------------------
# OPSİYONEL — izleme ve bildirim
# -----------------------------------------------------------------------------

# Hata izleme (Sentry). Yoksa hatalar yalnızca sunucu loglarına düşer.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Yeni talepler için Slack bildirimi. Yoksa Slack'e gönderim atlanır.
SLACK_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# ŞEMADA TANIMLI, HENÜZ KULLANILMIYOR
#
# Aşağıdakiler src/lib/env.ts şemasında yer alıyor ama kodda tüketen bir
# yer yok. İlgili özellik yazılana kadar boş bırakın.
# -----------------------------------------------------------------------------

# Analitik (Plausible) — script henüz eklenmedi.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# CRM (HubSpot) — entegrasyon henüz yazılmadı.
HUBSPOT_PRIVATE_TOKEN=


# -----------------------------------------------------------------------------
# GENEL SMTP (opsiyonel — Postmark yerine)
#
# Verilirse Postmark yerine bu kullanılır. İki işe yarar:
#   1. Yerel geliştirmede posta yakalayıcısına yönlendirmek
#      (docker-compose.dev.yml içindeki Mailpit — hesap gerektirmez)
#   2. Postmark dışında bir sağlayıcıya geçmek
#
# Yerel Mailpit için:
#   EMAIL_SERVER_HOST=localhost
#   EMAIL_SERVER_PORT=1025
#   EMAIL_FROM=bilgi@sitreyapi.local
# Kullanıcı/parola boş bırakılırsa kimlik doğrulamasız bağlanılır.
# -----------------------------------------------------------------------------
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=


# -----------------------------------------------------------------------------
# SHADOW VERİTABANI (yalnızca migration üretirken)
#
# !! Prisma bu adresteki TÜM VERİYİ SİLER. Asla üretim adresi vermeyin.
# `npm run db:diff` yerel olmayan bir adres görürse çalışmayı reddeder.
#
# Yerel yığınla:
#   docker compose -f docker-compose.dev.yml up -d
#   SHADOW_DATABASE_URL=postgresql://sitre:sitre_dev_local@localhost:5433/sitre_shadow
# -----------------------------------------------------------------------------
SHADOW_DATABASE_URL=
