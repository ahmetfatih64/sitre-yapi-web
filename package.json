{
  "name": "sitre-yapi-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "import-in-the-middle": "3.0.1"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/content-validate.mjs",
    "test:unit": "tsx --test packages/auth/src/*.test.ts packages/security/src/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.48.0",
    "@sitre/auth": "*",
    "@sitre/db": "*",
    "@sitre/security": "*",
    "@sitre/storage": "*",
    "clsx": "^2.1.1",
    "next": "15.1.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
