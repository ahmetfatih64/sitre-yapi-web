{
  "name": "sitre-yapi-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "import-in-the-middle": "3.0.1",
    "postcss": "^8.5.31"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/content-validate.mjs",
    "test:unit": "tsx --test packages/auth/src/*.test.ts packages/security/src/*.test.ts src/lib/*.test.ts src/content/*.test.ts src/content/projects/*.test.ts tests/guards/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check:env": "node scripts/env-check.mjs",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx scripts/seed-projects.ts",
    "db:promote": "tsx scripts/promote-user.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:diff": "node scripts/db-diff.mjs",
    "build:prod": "node scripts/prod.mjs build",
    "start:prod": "node scripts/prod.mjs start",
    "qa:acceptance": "node scripts/qa-acceptance.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.48.0",
    "@sitre/auth": "*",
    "@sitre/db": "*",
    "@sitre/security": "*",
    "@sitre/storage": "*",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.28",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
